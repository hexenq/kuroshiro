{
  "name": "kuroshiro",
  "version": "1.2.0",
  "description": "kuroshiro is a Japanese language library for converting Japanese sentence to Hiragana, Katakana or Romaji with furigana and okurigana modes supported.",
  "main": "index.js",
  "module": "src/index.js",
  "files": [
    "index.js",
    "lib",
    "dist",
    "src"
  ],
  "scripts": {
    "lint": "eslint src test scripts index.js eslint.config.mjs vite.config.mjs",
    "lint:fix": "npm run lint -- --fix",
    "jest": "jest --verbose",
    "jest:watch": "npm run jest -- --watch",
    "jest:coverage": "jest --verbose --coverage",
    "test:package": "node test/package-smoke.cjs",
    "test": "npm run lint && npm run jest && npm run build && npm run test:package",
    "clean": "rimraf lib dist",
    "build": "npm run clean && npm run build:cjs && npm run build:umd && npm run build:umd:min",
    "build:cjs": "cross-env BABEL_ENV=cjs babel src --out-dir lib",
    "build:umd": "vite build",
    "build:umd:min": "vite build --mode minify",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hexenq/kuroshiro.git"
  },
  "keywords": [
    "Japanese",
    "language",
    "convert",
    "converter",
    "kanji",
    "hiragana",
    "katakana",
    "kana",
    "romaji",
    "furigana",
    "okurigana",
    "library",
    "utility",
    "tool",
    "hepburn"
  ],
  "author": {
    "name": "Hexen Qi",
    "email": "hexenq@gmail.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hexenq/kuroshiro/issues"
  },
  "homepage": "https://github.com/hexenq/kuroshiro",
  "dependencies": {
    "@babel/runtime": "^7.29.7"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "acorn": "^8.18.0",
    "babel-jest": "^30.5.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "jsdom": "^26.1.0",
    "kuroshiro-analyzer-kuromoji": "^1.1.0",
    "rimraf": "^6.1.3",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=6.5.0"
  },
  "jest": {
    "transform": {
      "^.+\\.jsx?$": "babel-jest"
    },
    "testRegex": "(/test/.*|(\\.|/)(test|spec))\\.jsx?$"
  }
}
